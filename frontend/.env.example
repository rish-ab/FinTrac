# Leave empty to use the Vite dev-server proxy to the API below.
# In production, set this to the API origin or configure a same-origin reverse proxy.
VITE_API_BASE_URL=

# Vite development proxy target (defaults to http://localhost:8000).
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT_MS=30000
